#!/usr/bin/env python3
import json
import os
import sys

path = os.environ['LIFECYCLE_STATE']
with open(path, encoding='utf-8') as stream:
    state = json.load(stream)
args = [arg for arg in sys.argv[1:] if arg not in ('--no-pager', '--no-legend')]
for option in ('--property', '-p'):
    while option in args:
        index = args.index(option)
        del args[index:index + 2]
if not args:
    sys.exit(0)
command = args[0]
unit = next((arg for arg in args[1:] if not arg.startswith('-')), 'zabbix-server')

def save():
    with open(path, 'w', encoding='utf-8') as stream:
        json.dump(state, stream, sort_keys=True)

def event(name):
    state['events'].append(name)

if command == 'is-active':
    if not state['unit_exists']:
        print('unknown')
        sys.exit(4)
    print('active' if state['active'] else 'inactive')
    sys.exit(0 if state['active'] else 3)
if command == 'show':
    if not state['unit_exists']:
        print('LoadState=not-found\nActiveState=inactive\nUnitFileState=masked' if state['masked'] else 'LoadState=not-found\nActiveState=inactive\nUnitFileState=disabled')
    else:
        print('LoadState=loaded')
        print('ActiveState=' + ('active' if state['active'] else 'inactive'))
        print('UnitFileState=' + ('masked' if state['masked'] else ('enabled' if state['enabled'] else 'disabled')))
    sys.exit(0)
if command == 'is-enabled':
    print('masked' if state['masked'] else ('enabled' if state['enabled'] else 'disabled'))
    sys.exit(0 if state['enabled'] and not state['masked'] else 1)
if command in ('mask', 'unmask', 'start', 'stop', 'restart', 'enable', 'disable'):
    event(command)
    if command == 'mask':
        state['masked'] = True
        state['active'] = False
    elif command == 'unmask':
        state['masked'] = False
    elif command == 'start':
        if state['masked'] or not state['unit_exists']:
            save(); sys.exit(1)
        state['active'] = True
    elif command == 'stop':
        state['active'] = False
    elif command == 'restart':
        if state['masked'] or not state['unit_exists']:
            save(); sys.exit(1)
        state['active'] = True
    elif command == 'enable':
        state['enabled'] = True
    elif command == 'disable':
        state['enabled'] = False
    save()
    sys.exit(0)
if command in ('daemon-reload', 'reset-failed'):
    sys.exit(0)
print('unsupported fake systemctl call: ' + repr(sys.argv), file=sys.stderr)
sys.exit(2)
