#!/usr/bin/env python3
import os
import sys

args = sys.argv[1:]
index = 0
while index < len(args):
    arg = args[index]
    if arg in ('-u', '-g', '-h', '-p', '-C', '-T'):
        index += 2
    elif arg.startswith('-'):
        index += 1
    else:
        break
if index == len(args):
    sys.exit(0)
os.execvp(args[index], args[index:])
